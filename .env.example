# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: browser key for address suggestions (Places API (New)).
# Restrict it to the site domains in Google Cloud. Without it the address is typed by hand.
VITE_GOOGLE_MAPS_API_KEY=""

# Wompi (pagos en línea). Llaves de pruebas: pub_test_… / test_integrity_… / test_events_…
# VITE_WOMPI_PUBLIC_KEY es pública (va al navegador). Las otras tres son SECRETAS: solo en Vercel, nunca en el código.
VITE_WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
# JSON completo de la cuenta de servicio de Firebase (Configuración del proyecto → Cuentas de servicio), en una sola línea.
FIREBASE_SERVICE_ACCOUNT=""

# Bold (pagos en línea; si VITE_BOLD_API_KEY está cargada, Bold reemplaza a Wompi). Panel de Bold → Integraciones → Llaves de integración.
# VITE_BOLD_API_KEY es la llave de identidad (pública, va al navegador). BOLD_SECRET_KEY es SECRETA: solo en Vercel.
# BOLD_TEST_MODE=true mientras uses llaves de pruebas (el webhook de pruebas firma con llave vacía); quítala en producción.
VITE_BOLD_API_KEY=""
BOLD_SECRET_KEY=""
BOLD_TEST_MODE=""

# Correo de confirmación de pago (opcional, Resend). EMAIL_FROM debe ser de un dominio verificado en Resend.
RESEND_API_KEY=""
EMAIL_FROM="Fresh Pick <pedidos@freshpickfruits.com>"
# Correos del equipo (separados por coma): reciben aviso de pedido nuevo, pago aprobado y pago rechazado. Por defecto: freshpickfruits@gmail.com
EMAIL_TEAM=""

# Avisos por departamento (opcional). JSON con los grupos que reciben avisos de pedido nuevo, pago aprobado y pago rechazado:
# [{"nombre":"Finanzas","emails":["a@x.com"],"whatsapp":["3001234567"],"eventos":["pedido_nuevo","pago_aprobado","pago_rechazado"]}]
# Sin NOTIFY_TEAMS se usa un solo grupo: EMAIL_TEAM (o freshpickfruits@gmail.com) y WHATSAPP_TEAM_NUMBERS (separados por coma).
NOTIFY_TEAMS=""
WHATSAPP_TEAM_NUMBERS=""

# WhatsApp Cloud API de Meta (opcional). Token permanente de un usuario del sistema y el ID del número (WhatsApp Manager → Configuración de la API).
# Plantillas a crear y aprobar en Meta (categoría Utilidad, idioma español): aviso_equipo ({{1}} título, {{2}} detalle),
# pedido_recibido, pago_confirmado y pago_rechazado ({{1}} nombre, {{2}} N° de pedido, {{3}} total).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
