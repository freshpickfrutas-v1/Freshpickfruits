rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones auxiliares ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Administradores de arranque: siempre pueden entrar como admin y asignar roles a los demás.
    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email in ['info@freshpickfruits.com', 'freshpickfrutas@gmail.com'];
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isBootstrapAdmin() || (hasProfile() && myRole() == 'admin');
    }

    // Cualquier miembro del equipo (admin, finanzas, poscosecha, contabilidad, asistente, domiciliario).
    function isStaff() {
      return isAdmin() || (hasProfile() && myRole() in ['finanzas', 'poscosecha', 'contabilidad', 'asistente', 'domiciliario']);
    }

    // ---------- Perfiles de usuario ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Un usuario nuevo solo puede crearse como cliente (nadie se asigna rol del equipo).
      allow create: if isOwner(userId) && (request.resource.data.role == 'customer' || isBootstrapAdmin());

      // El dueño edita sus datos pero NO su rol; el admin puede cambiar cualquier perfil.
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ---------- Pedidos ----------
    match /orders/{orderId} {
      // Compra como invitado o con sesión: el pedido nace "pendiente" y, si trae userId, debe ser el de quien lo crea.
      allow create: if request.resource.data.status == 'pendiente'
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.customerName is string
        && request.resource.data.items is list
        && (request.resource.data.userId == null
            || (isSignedIn() && request.resource.data.userId == request.auth.uid));

      // El equipo ve todos; el cliente solo los suyos (por cuenta o por correo verificado).
      allow read: if isStaff()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isVerified() && resource.data.customerEmail == request.auth.token.email);

      // Fase 2 afinará qué rol puede mover cada estado.
      allow update: if isStaff();

      allow delete: if isAdmin();
    }

    // ---------- Suscripciones ----------
    match /subscriptions/{subId} {
      // El cliente solicita un plan a su nombre; nace "solicitada" y el equipo la activa.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'solicitada'
        && request.resource.data.planId is string
        && request.resource.data.priceMonth is number;

      // El equipo ve todas; el cliente solo las suyas.
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // El equipo gestiona; el cliente solo puede pedir pausa o cancelación (esos dos campos).
      allow update: if isStaff()
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerRequest', 'customerRequestAt']));

      allow delete: if isAdmin();
    }

    // ---------- Catálogo ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
