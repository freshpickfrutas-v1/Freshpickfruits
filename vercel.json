{
  "crons": [
    {
      "path": "/api/cron/video-diario?fase=correo",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/video-diario?fase=publicar",
      "schedule": "30 17 * * *"
    }
  ],
  "functions": {
    "api/admin/social-queue.ts": {
      "maxDuration": 60
    },
    "api/cron/social-drafts.ts": {
      "maxDuration": 60
    },
    "api/admin/publish-social.ts": {
      "maxDuration": 60
    },
    "api/cron/video-diario.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/blog",
      "destination": "/noticias",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/noticias/:path*",
      "permanent": true
    },
    {
      "source": "/en/blog",
      "destination": "/en/noticias",
      "permanent": true
    },
    {
      "source": "/en/blog/:path*",
      "destination": "/en/noticias/:path*",
      "permanent": true
    },
    {
      "source": "/mayoristas/colombia",
      "destination": "/mayoristas",
      "permanent": true
    },
    {
      "source": "/mayoristas/mundo",
      "destination": "/en/mayoristas",
      "permanent": true
    },
    {
      "source": "/en/mayoristas/colombia",
      "destination": "/en/mayoristas",
      "permanent": true
    },
    {
      "source": "/en/mayoristas/mundo",
      "destination": "/en/mayoristas",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://yogic-oxygen-h53bd-869ca.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/privacidad",
      "destination": "/app-shell.html"
    },
    {
      "source": "/terminos",
      "destination": "/app-shell.html"
    },
    {
      "source": "/gracias",
      "destination": "/app-shell.html"
    },
    {
      "source": "/cookies",
      "destination": "/app-shell.html"
    },
    {
      "source": "/panel",
      "destination": "/app-shell.html"
    },
    {
      "source": "/panel/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/recetas",
      "destination": "/app-shell.html"
    },
    {
      "source": "/recetas/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/noticias",
      "destination": "/app-shell.html"
    },
    {
      "source": "/noticias/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/panel",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/panel/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/gracias",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/privacidad",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/terminos",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/cookies",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/recetas",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/recetas/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/noticias",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/noticias/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/mayoristas",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/mayoristas/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/arandanos-a-domicilio-bogota",
      "destination": "/app-shell.html"
    },
    {
      "source": "/en/arandanos-a-domicilio-bogota",
      "destination": "/app-shell.html"
    },
    {
      "source": "/mayoristas",
      "destination": "/app-shell.html"
    },
    {
      "source": "/mayoristas/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/((?!__/auth/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net https://checkout.wompi.co https://checkout.bold.co https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.facebook.com https://connect.facebook.net https://checkout.wompi.co https://*.wompi.co https://*.bold.co https://yogic-oxygen-h53bd-869ca.firebaseapp.com wss://*.firebaseio.com https://vitals.vercel-insights.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://checkout.wompi.co https://checkout.bold.co https://yogic-oxygen-h53bd-869ca.firebaseapp.com https://accounts.google.com https://www.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://checkout.wompi.co https://checkout.bold.co; object-src 'none'"
        }
      ]
    }
  ]
}
