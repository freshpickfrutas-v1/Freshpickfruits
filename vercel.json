{
  "redirects": [
    {
      "source": "/blog",
      "destination": "/noticias",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/noticias/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://yogic-oxygen-h53bd-869ca.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/privacidad",
      "destination": "/app-shell.html"
    },
    {
      "source": "/terminos",
      "destination": "/app-shell.html"
    },
    {
      "source": "/gracias",
      "destination": "/app-shell.html"
    },
    {
      "source": "/cookies",
      "destination": "/app-shell.html"
    },
    {
      "source": "/panel",
      "destination": "/app-shell.html"
    },
    {
      "source": "/panel/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/recetas",
      "destination": "/app-shell.html"
    },
    {
      "source": "/recetas/(.*)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/noticias",
      "destination": "/app-shell.html"
    },
    {
      "source": "/noticias/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    }
  ]
}
